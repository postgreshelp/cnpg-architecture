# CNPG will auto-generate a superuser secret if you omit this, but an explicit one lets you
# control the password up front (matches TARS's pattern of operator-managed but predictable creds).
apiVersion: v1
kind: Secret
metadata:
  name: tarsdb-primary-superuser
  namespace: tars-db
type: kubernetes.io/basic-auth
stringData:
  username: postgres
  password: ChangeMe_PgSuperuser!
