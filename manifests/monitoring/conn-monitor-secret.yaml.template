# Copy to conn-monitor-secret.yaml, fill in a real password, then:
#   kubectl apply -f conn-monitor-secret.yaml -n tars-common
apiVersion: v1
kind: Secret
metadata:
  name: tars-monitor-db          # mirrors TARS's tars-monitor-db secret name (§8 operational note)
  namespace: tars-common
type: Opaque
stringData:
  PGHOST: tarsdb-primary-rw.tars-db.svc.cluster.local.   # trailing dot: absolute FQDN, skips ndots search-domain expansion for this cross-namespace name
  PGPORT: "5432"
  PGUSER: postgres
  PGPASSWORD: "CHANGE_ME"
  PGDATABASE: postgres
